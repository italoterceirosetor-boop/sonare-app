{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid && (!newData.exists() || newData.val() === 'professor')) || ($uid === auth.uid && newData.val() === 'professor' && auth.token.email != null && auth.token.email_verified === true && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
      }
    },
    "professores": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$chave": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $chave",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "acesso": {
          ".write": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $chave && root.child('professores').child($chave).child('email').exists()"
        }
      }
    },
    "conteudo": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
    },
    "aulas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
    },
    "codigos": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      "$codigo": {
        ".read": "auth != null"
      }
    },
    "vinculos": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && root.child('codigos').child(newData.val()).exists()))"
      }
    },
    "alunos": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('admins').child(auth.uid).val() === 'professor' && auth.token.email != null && root.child('professores').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      "$id": {
        ".read": "auth != null && root.child('vinculos').child(auth.uid).exists() && root.child('codigos').child(root.child('vinculos').child(auth.uid).val()).child('alunoId').val() === $id && root.child('alunos').child($id).child('revogado').val() !== true",
        "ritmos": {
          ".write": "auth != null && root.child('vinculos').child(auth.uid).exists() && root.child('codigos').child(root.child('vinculos').child(auth.uid).val()).child('alunoId').val() === $id && root.child('alunos').child($id).child('revogado').val() !== true"
        },
        "progresso": {
          ".write": "auth != null && root.child('vinculos').child(auth.uid).exists() && root.child('codigos').child(root.child('vinculos').child(auth.uid).val()).child('alunoId').val() === $id && root.child('alunos').child($id).child('revogado').val() !== true",
          ".validate": "newData.hasChild('updatedAt')",
          "$campo": {
            ".validate": "$campo === 'updatedAt' ? newData.isNumber() : (newData.isString() && newData.val().length < 200000)"
          }
        }
      }
    }
  }
}
